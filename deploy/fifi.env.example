# Copy to /etc/fifi/fifi.env and fill in. Keep it readable by root only:
#   sudo chmod 600 /etc/fifi/fifi.env

# Required — your bot token from the Discord Developer Portal
DISCORD_TOKEN=paste-token-here

# Where the bot reads/writes its config. Seeded on first deploy from
# Feral_Kitty_FiFi/data/config.json (see DEPLOY.md). Keeping it under
# /opt/fifi/data keeps runtime state out of the git tree.
FKF_CONFIG_PATH=/opt/fifi/data/config.json

# --- gimme_report (roster/ban/leave XLSX report) ---
# These were Railway Variables; copy the same values over.
REPORT_CHANNEL_ID=0
JOIN_LEAVE_LOG_CHANNEL_IDS=
BAN_LOG_CHANNEL_ID=0
# Optional overrides:
# TRIGGER=!gimme
# BACKFILL_MAX_MESSAGES_PER_CHANNEL=50000
# DB_PATH=/opt/fifi/data/gimme_report.sqlite
